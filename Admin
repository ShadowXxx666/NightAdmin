    local FlashStates = {}

    local function FlashFolder()
        local camera = Workspace.CurrentCamera
        if not camera then return nil end
        local folder = camera:FindFirstChild("NightHub_FlashFX")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "NightHub_FlashFX"
            folder.Parent = camera
        end
        return folder
    end

    local function ClearFlashObjects(state)
        for _, object in ipairs(state.objects or {}) do
            pcall(function() object:Destroy() end)
        end
        state.objects = {}
    end

    local function FlashBolt(p0, p1, thickness, straight)
        local folder = FlashFolder()
        if not folder then return end
        local distance = (p1 - p0).Magnitude
        if distance < 0.5 then return end

        local segments = math.clamp(math.floor(distance * 1.6), 5, 24)
        local cf = CFrame.lookAt(p0, p1)
        local jitter = distance * (straight and 0.01 or 0.075)

        local holder = Instance.new("Part")
        holder.Anchored, holder.CanCollide, holder.CanQuery, holder.CanTouch = true, false, false, false
        holder.Transparency = 1
        holder.Size = Vector3.new(0.1, 0.1, 0.1)
        holder.CFrame = CFrame.new(p0)
        holder.Parent = folder

        local attachments = {}
        for i = 0, segments do
            local amount = (i == 0 or i == segments) and 0 or jitter
            local attachment = Instance.new("Attachment")
            attachment.Parent = holder
            attachment.WorldPosition = p0:Lerp(p1, i / segments)
                + cf.RightVector * (math.random() - 0.5) * 2 * amount
                + cf.UpVector * (math.random() - 0.5) * 2 * amount
            attachments[i + 1] = attachment
        end

        for i = 1, segments do
            for _, layer in ipairs({
                { Color3.fromRGB(255, 215, 40), 0.55 * thickness, 0.6 },
                { Color3.new(1, 1, 1), 0.14 * thickness, 0 },
            }) do
                local beam = Instance.new("Beam")
                beam.Attachment0, beam.Attachment1 = attachments[i], attachments[i + 1]
                beam.Segments, beam.FaceCamera = 1, true
                beam.Color = ColorSequence.new(layer[1])
                beam.LightEmission, beam.LightInfluence = 1, 0
                beam.Width0, beam.Width1 = layer[2], layer[2]
                beam.Transparency = NumberSequence.new(layer[3])
                beam.Parent = holder
            end
        end

        Debris:AddItem(holder, 0.13)
    end

    local function ApplyFlashToPlayer(player, state)
        if not player or not state or FlashStates[player.Name] ~= state then return end

        local character = player.Character
        if not character then
            character = player.CharacterAdded:Wait()
        end
        if FlashStates[player.Name] ~= state then return end

        -- O comando pode chegar durante o respawn: aguarda as peças essenciais.
        local root = character:FindFirstChild("HumanoidRootPart")
            or character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 10)
        if not root or FlashStates[player.Name] ~= state then return end

        ClearFlashObjects(state)
        state.character = character
        local function keep(object)
            table.insert(state.objects, object)
            return object
        end

        if player == LocalPlayer and humanoid then
            state.originalWalkSpeeds = state.originalWalkSpeeds or {}
            if state.originalWalkSpeeds[character] == nil then
                state.originalWalkSpeeds[character] = humanoid.WalkSpeed
            end
            humanoid.WalkSpeed = 200
        end

        local attachment = keep(Instance.new("Attachment"))
        attachment.Parent = root

        local emitter = Instance.new("ParticleEmitter")
        emitter.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 230, 60)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 140, 0)),
        })
        emitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.35),
            NumberSequenceKeypoint.new(1, 0),
        })
        emitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        })
        emitter.Rate = 60
        emitter.Lifetime = NumberRange.new(0.1, 0.3)
        emitter.Speed = NumberRange.new(8, 20)
        emitter.SpreadAngle = Vector2.new(360, 360)
        emitter.LightEmission = 1
        emitter.Parent = attachment

        local top = keep(Instance.new("Attachment"))
        top.Position = Vector3.new(0, 2, 0)
        top.Parent = root

        local bottom = keep(Instance.new("Attachment"))
        bottom.Position = Vector3.new(0, -2, 0)
        bottom.Parent = root

        local trail = keep(Instance.new("Trail"))
        trail.Attachment0, trail.Attachment1 = top, bottom
        trail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 220, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 0)),
        })
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(1, 1),
        })
        trail.LightEmission, trail.Lifetime, trail.MinLength = 1, 0.3, 0.01
        trail.Parent = root

        local light = keep(Instance.new("PointLight"))
        light.Color, light.Brightness, light.Range = Color3.fromRGB(255, 220, 60), 3, 14
        light.Parent = root

        local highlight = keep(Instance.new("Highlight"))
        highlight.FillColor, highlight.OutlineColor = Color3.fromRGB(255, 220, 40), Color3.new(1, 1, 1)
        highlight.FillTransparency, highlight.OutlineTransparency = 0.88, 0.3
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded
        highlight.Parent = character

        task.spawn(function()
            while FlashStates[player.Name] == state and state.character == character and root.Parent do
                local velocity = root.AssemblyLinearVelocity
                local speed = velocity.Magnitude
                local amount = speed > 25 and 3 or (speed > 5 and 2 or 1)

                for _ = 1, amount do
                    local origin = root.Position + Vector3.new(
                        math.random(-130, 130) / 100,
                        math.random(-260, 220) / 100,
                        math.random(-130, 130) / 100
                    )
                    local randomDirection = Vector3.new(
                        math.random() - 0.5,
                        math.random() - 0.5,
                        math.random() - 0.5
                    )
                    if randomDirection.Magnitude < 0.01 then
                        randomDirection = Vector3.new(0, 1, 0)
                    end

                    local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
                    if horizontalVelocity.Magnitude > 20 then
                        local direction = (-horizontalVelocity.Unit + randomDirection.Unit * 0.06).Unit
                        FlashBolt(origin, origin + direction * math.random(18, 36), 1.1, true)
                    else
                        local direction = randomDirection.Unit
                        if speed > 5 then
                            direction = (direction * 0.8 - velocity.Unit * 0.9).Unit
                        end
                        FlashBolt(origin, origin + direction * math.random(10, 20), 1.0, false)
                    end
                end

                light.Brightness = 2 + math.random() * 4
                highlight.FillTransparency = 0.78 + math.random() * 0.15
                task.wait(0.03 + math.random() * 0.04)
            end
        end)
    end

    local function SetFlashForPlayer(player, enabled)
        if not player then return end

        if enabled then
            if FlashStates[player.Name] then return end
            local state = { objects = {} }
            FlashStates[player.Name] = state

            state.characterConnection = player.CharacterAdded:Connect(function(character)
                character:WaitForChild("HumanoidRootPart", 10)
                task.wait(0.15)
                if FlashStates[player.Name] == state then
                    ApplyFlashToPlayer(player, state)
                end
            end)

            ApplyFlashToPlayer(player, state)
        else
            local state = FlashStates[player.Name]
            if not state then return end
            FlashStates[player.Name] = nil

            if state.characterConnection then
                state.characterConnection:Disconnect()
            end
            ClearFlashObjects(state)

            if player == LocalPlayer then
                local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                local original = state.originalWalkSpeeds and state.originalWalkSpeeds[player.Character]
                if humanoid and original ~= nil then
                    humanoid.WalkSpeed = original
                end
            end
        end
    end

    local function ToggleFlashForPlayer(player)
        if not player then return end
        SetFlashForPlayer(player, FlashStates[player.Name] == nil)
    end

    Players.PlayerRemoving:Connect(function(player)
        if FlashStates[player.Name] then
            SetFlashForPlayer(player, false)
        end
    end)


