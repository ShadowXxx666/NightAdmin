    local function getRealImageIdDelta(id)
        local cleanId = tostring(id):match("%d+")
        if not cleanId then return "rbxassetid://" .. tostring(id) end
        return "rbxassetid://" .. cleanId
    end

    local imageCache = {}
    local function resolveImage(id)
        local clean = tostring(id):match("%d+")
        if not clean then return tostring(id) end
        if imageCache[clean] then return imageCache[clean] end

        local fallback = "rbxassetid://" .. clean
        local result = fallback
        local objects
        local ok, loaded = pcall(function() return game:GetObjects(fallback) end)
        if ok and loaded and loaded[1] then objects = loaded end

        if not objects then
            local okInsert, asset = pcall(function()
                return game:GetService("InsertService"):LoadAsset(tonumber(clean))
            end)
            if okInsert and asset then objects = asset:GetChildren() end
        end

        if objects and objects[1] then
            local object = objects[1]
            local texture
            if object:IsA("Decal") or object:IsA("Texture") then
                texture = object.Texture
            elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
                texture = object.Image
            else
                local decal = object:FindFirstChildWhichIsA("Decal", true)
                    or object:FindFirstChildWhichIsA("Texture", true)
                if decal then texture = decal.Texture end
            end
            if texture and texture ~= "" then result = texture end
            pcall(function() object:Destroy() end)
        end

        imageCache[clean] = result
        return result
    end

