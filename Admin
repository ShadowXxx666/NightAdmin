    local function ScreenTransition(teleportCallback)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then
            if teleportCallback then teleportCallback() end
            return
        end

        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "TransitionGui"
        screenGui.IgnoreGuiInset = true
        screenGui.ResetOnSpawn = false
        screenGui.Parent = playerGui

        local frame = Instance.new("Frame")
        frame.Size = UDim2.fromScale(1, 1)
        frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        frame.BackgroundTransparency = 1
        frame.Parent = screenGui

        local tweenOut = TweenService:Create(frame, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
        tweenOut:Play()
        tweenOut.Completed:Wait()

        if teleportCallback then
            pcall(teleportCallback)
        end

        task.wait(0.3)

        local tweenIn = TweenService:Create(frame, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
        tweenIn:Play()
        tweenIn.Completed:Wait()

        screenGui:Destroy()
    end

    -- ============================================================
    -- FNAF CHAPTER 1 - mapa fan-inspired, construído localmente.
    -- Mantém o estilo de uma pizzaria de terror com escritório,
    -- palco, salas e corredores, sem depender de outro mapa.
    -- ============================================================
    local FNAFFolder = nil
    local FNAFSpawnPos = CFrame.new(52000, 103, 52058)

    local function BuildFNAFChapter1Map()
        if FNAFFolder and FNAFFolder.Parent then return end

        FNAFFolder = Instance.new("Folder")
        FNAFFolder.Name = "NightHubFNAFChapter1Map"
        FNAFFolder.Parent = workspace

        local baseX, baseZ = 52000, 52000
        local floorY = 100
        local wallY = 106
        local wallH = 12
        local wallT = 1.5

        -- Rework: mapa muito mais claro, com salas separadas, portas visíveis,
        -- iluminação forte e elementos grandes para funcionar melhor no mobile.
        local C = {
            wall = Color3.fromRGB(88, 82, 78),
            wallLight = Color3.fromRGB(112, 103, 96),
            floor = Color3.fromRGB(54, 54, 58),
            floorTile = Color3.fromRGB(70, 70, 74),
            red = Color3.fromRGB(190, 38, 38),
            darkRed = Color3.fromRGB(85, 18, 18),
            yellow = Color3.fromRGB(255, 208, 72),
            white = Color3.fromRGB(235, 235, 228),
            black = Color3.fromRGB(18, 18, 20),
            blue = Color3.fromRGB(70, 150, 255),
        }

        local function part(name, size, pos, color, material, parent)
            local p = Instance.new("Part")
            p.Name = name
            p.Size = size
            p.Position = pos
            p.Anchored = true
            p.CanCollide = true
            p.TopSurface = Enum.SurfaceType.Smooth
            p.BottomSurface = Enum.SurfaceType.Smooth
            p.Color = color or C.wall
            p.Material = material or Enum.Material.SmoothPlastic
            p.Parent = parent or FNAFFolder
            return p
        end

        local function wall(name, size, pos, color)
            return part(name, size, pos, color or C.wall, Enum.Material.SmoothPlastic)
        end

        local function floor(name, size, pos, color)
            return part(name, size, pos, color or C.floor, Enum.Material.Concrete)
        end

        -- Textura quadriculada encontrada no Creator Store para a área FNAF.
        -- Aplicada somente na face superior para não cobrir as laterais do piso.
        local function applyFNAFFloorTexture(floorPart, tileU, tileV)
            if not floorPart then return end
            local texture = Instance.new("Texture")
            texture.Name = "FNAF_CheckeredFloorTexture"
            texture.Texture = "rbxassetid://14797573654"
            texture.Face = Enum.NormalId.Top
            texture.StudsPerTileU = tileU or 8
            texture.StudsPerTileV = tileV or 8
            texture.Transparency = 0
            texture.Parent = floorPart
            return texture
        end

        local function light(pos, color, brightness, range, size)
            local anchor = part("FNAF_Light", size or Vector3.new(1,1,1), pos, color or C.white, Enum.Material.Neon)
            anchor.Transparency = 1
            anchor.CanCollide = false
            local pl = Instance.new("PointLight")
            pl.Color = color or C.white
            pl.Brightness = brightness or 2.5
            pl.Range = range or 30
            pl.Shadows = false
            pl.Parent = anchor
            return anchor
        end

        local function ceilingLamp(pos)
            local lamp = part("CeilingLamp", Vector3.new(8, 0.25, 3), pos, C.white, Enum.Material.Neon)
            lamp.CanCollide = false
            local sl = Instance.new("SurfaceLight")
            sl.Face = Enum.NormalId.Bottom
            sl.Brightness = 5
            sl.Range = 28
            sl.Angle = 120
            sl.Color = Color3.fromRGB(255, 245, 215)
            sl.Shadows = false
            sl.Parent = lamp
            return lamp
        end

        local function textSign(name, text, pos, size, color)
            local sign = part(name, Vector3.new(size.X, size.Y, 0.5), pos, C.black, Enum.Material.SmoothPlastic)
            local gui = Instance.new("SurfaceGui")
            gui.Face = Enum.NormalId.Front
            gui.AlwaysOnTop = true
            gui.PixelsPerStud = 45
            gui.Parent = sign
            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1,1)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = color or C.yellow
            label.TextStrokeTransparency = 0.35
            label.Font = Enum.Font.GothamBold
            label.TextScaled = true
            label.Parent = gui
            return sign
        end

        local function doorway(name, x, z, side)
            -- Frame + recessed red security door. The doorway remains visually obvious.
            local doorColor = C.red
            if side == "Left" or side == "Right" then
                part(name .. "_Top", Vector3.new(4, 1.2, 20), Vector3.new(x, 112, z), C.black, Enum.Material.Metal)
                part(name .. "_FrameA", Vector3.new(4, 12, 1.2), Vector3.new(x, 106, z - 9.4), C.darkRed, Enum.Material.Metal)
                part(name .. "_FrameB", Vector3.new(4, 12, 1.2), Vector3.new(x, 106, z + 9.4), C.darkRed, Enum.Material.Metal)
                local door = part(name .. "_Door", Vector3.new(4, 10, 16), Vector3.new(x, 105, z), doorColor, Enum.Material.Metal)
                local stripe = part(name .. "_Stripe", Vector3.new(4.15, 1, 16), Vector3.new(x, 108, z), C.yellow, Enum.Material.Neon)
                stripe.CanCollide = false
                textSign(name .. "_Label", "DOOR", Vector3.new(x + (side == "Left" and -2.1 or 2.1), 112.8, z), Vector2.new(9, 3), C.yellow)
                return door
            end
        end

        -- Overall building.
        floor("MainFloor", Vector3.new(220, 1, 150), Vector3.new(baseX, floorY, baseZ))
        part("Ceiling", Vector3.new(220, 1, 150), Vector3.new(baseX, 114, baseZ), Color3.fromRGB(38,38,42), Enum.Material.Concrete)

        -- Main exterior walls.
