    -- ============================================================
    -- LOOPKILL / FLOAT
    -- LoopKill repete o Kill no alvo enquanto estiver ativo.
    -- Float faz o alvo subir continuamente em direcao ao ceu.
    -- ============================================================
    local LoopKillActive = {}
    local FloatActive = {}
    local FloatVelocity = {}

    local function StopLoopKill(targetName)
        LoopKillActive[targetName] = nil
    end

    local function TriggerLoopKill(targetPlayer)
        if not targetPlayer then return end

        local targetName = targetPlayer.Name
        if LoopKillActive[targetName] then
            StopLoopKill(targetName)
            return
        end

        LoopKillActive[targetName] = true

        task.spawn(function()
            while LoopKillActive[targetName] and targetPlayer.Parent do
                local character = targetPlayer.Character
                if character then
                    pcall(function()
                        character:BreakJoints()
                    end)
                end
                task.wait(0.25)
            end
        end)
    end

    local function UnLoopKill(targetPlayer)
        if not targetPlayer then return end
        StopLoopKill(targetPlayer.Name)
    end

    local function TriggerFloat(targetPlayer)
        if not targetPlayer then return end

        local targetName = targetPlayer.Name
        if FloatActive[targetName] then
            FloatActive[targetName] = nil
            if FloatVelocity[targetName] then
                pcall(function() FloatVelocity[targetName]:Destroy() end)
                FloatVelocity[targetName] = nil
            end
            return
        end

        FloatActive[targetName] = true

        task.spawn(function()
            while FloatActive[targetName] and targetPlayer.Parent do
                local character = targetPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                local hum = character and character:FindFirstChildOfClass("Humanoid")

                if hrp and hum and hum.Health > 0 then
                    local bv = FloatVelocity[targetName]
                    if not bv or not bv.Parent then
                        bv = Instance.new("BodyVelocity")
                        bv.Name = "NightHubFloat"
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Velocity = Vector3.new(0, 65, 0)
                        bv.Parent = hrp
                        FloatVelocity[targetName] = bv
                    else
                        bv.Velocity = Vector3.new(0, 65, 0)
                    end
                end

                task.wait(0.1)
            end

            if FloatVelocity[targetName] then
                pcall(function() FloatVelocity[targetName]:Destroy() end)
                FloatVelocity[targetName] = nil
            end
        end)
    end

    local function UnFloat(targetPlayer)
        if not targetPlayer then return end

        local targetName = targetPlayer.Name
        FloatActive[targetName] = nil

        if FloatVelocity[targetName] then
            pcall(function() FloatVelocity[targetName]:Destroy() end)
            FloatVelocity[targetName] = nil
        end
    end

