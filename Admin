    local function StartGlitch(player)
        if not player or not player.Character then return end
        if GLITCHED_PLAYERS[player.Name] and GLITCHED_PLAYERS[player.Name].loop then
            task.cancel(GLITCHED_PLAYERS[player.Name].loop)
        end

        local loopTask = task.spawn(function()
            while GLITCHED_PLAYERS[player.Name] and player.Parent and player.Character do
                pcall(function()
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local desc = hum:GetAppliedDescription()
                        if desc then
                            desc.RigType = Enum.HumanoidRigType.R6
                            hum:ApplyDescription(desc)
                        end
                    end
                end)
                task.wait(0.2)
                pcall(function()
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local desc = hum:GetAppliedDescription()
                        if desc then
                            desc.RigType = Enum.HumanoidRigType.R15
                            hum:ApplyDescription(desc)
                        end
                    end
                end)
                task.wait(0.2)
            end
        end)
        GLITCHED_PLAYERS[player.Name] = { loop = loopTask }
    end

    local function StopGlitch(player)
        if not player then return end
        if GLITCHED_PLAYERS[player.Name] then
            if GLITCHED_PLAYERS[player.Name].loop then
                task.cancel(GLITCHED_PLAYERS[player.Name].loop)
            end
            GLITCHED_PLAYERS[player.Name] = nil
        end
    end

