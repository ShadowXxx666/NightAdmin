    -- Efeito de ragdoll com som; só é aplicado no cliente-alvo que executa o comando.
    local RagdollActive = false
    local function TriggerRagdollEffect(targetPlayer)
        if targetPlayer ~= LocalPlayer or RagdollActive then return end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then
            WindUI:Notify({Title = "Ragdoll", Content = "O personagem não está disponível.", Duration = 3})
            return
        end

        RagdollActive = true
        local crackSound = Instance.new("Sound")
        crackSound.Name = "NightHubRagdollSFX"
        crackSound.SoundId = "rbxassetid://9113964719"
        crackSound.Volume = 0.85
        crackSound.Looped = false
        crackSound.Parent = root
        crackSound:Play()

        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            humanoid.PlatformStand = true
        end)

        task.delay(3.5, function()
            if humanoid and humanoid.Parent and humanoid.Health > 0 then
                pcall(function()
                    humanoid.PlatformStand = false
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
            if crackSound then crackSound:Destroy() end
            RagdollActive = false
        end)
    end

    -- God Mode local: tenta manter a vida cheia enquanto este cliente estiver ativo.
    local GodModeActive = false
    local GodModeHealthConnection = nil
    local GodModeCharacterConnection = nil
    local function ApplyGodModeToLocalCharacter()
        if not GodModeActive then return end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        if GodModeHealthConnection then GodModeHealthConnection:Disconnect(); GodModeHealthConnection = nil end
        pcall(function()
            humanoid.MaxHealth = 1000000000
            humanoid.Health = humanoid.MaxHealth
        end)
        GodModeHealthConnection = humanoid.HealthChanged:Connect(function(health)
            if GodModeActive and humanoid.Parent and health < humanoid.MaxHealth then
                pcall(function() humanoid.Health = humanoid.MaxHealth end)
            end
        end)
    end

    local function SetGodMode(targetPlayer)
        if targetPlayer ~= LocalPlayer then return end
        GodModeActive = true
        ApplyGodModeToLocalCharacter()
        if not GodModeCharacterConnection then
            GodModeCharacterConnection = LocalPlayer.CharacterAdded:Connect(function()
                task.wait(0.5)
                ApplyGodModeToLocalCharacter()
            end)
        end
        WindUI:Notify({Title = "God Mode", Content = "God Mode ativado neste cliente.", Duration = 3})
    end

    local function SetUngodMode(targetPlayer)
        if targetPlayer ~= LocalPlayer then return end
        GodModeActive = false
        if GodModeHealthConnection then GodModeHealthConnection:Disconnect(); GodModeHealthConnection = nil end
        if GodModeCharacterConnection then GodModeCharacterConnection:Disconnect(); GodModeCharacterConnection = nil end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                humanoid.MaxHealth = 100
                humanoid.Health = math.min(humanoid.Health, humanoid.MaxHealth)
            end)
        end
        WindUI:Notify({Title = "God Mode", Content = "God Mode desativado neste cliente.", Duration = 3})
    end

