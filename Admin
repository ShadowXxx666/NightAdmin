    local function ParseAndExecuteChatCommand(speakerPlayer, message)
        message = message:match("^%s*(.-)%s*$")
        if message:sub(1, 1) ~= ";" then return end
        if not OWNERS[speakerPlayer.Name] and not MODS[speakerPlayer.Name] and not CLIENTS[speakerPlayer.Name] then return end

        local spaceIndex = message:find(" ")
        local cmdStr, targetStr, extraArgs
        if spaceIndex then
            cmdStr = message:sub(2, spaceIndex - 1):upper()
            local remainder = message:sub(spaceIndex + 1):match("^%s*(.-)%s*$")
            
            if cmdStr == "SAY" or cmdStr == "KICK" then
                local nextSpace = remainder:find(" ")
                if nextSpace then
                    targetStr = remainder:sub(1, nextSpace - 1)
                    extraArgs = remainder:sub(nextSpace + 1):match("^%s*(.-)%s*$")
                else
                    targetStr = remainder
                    extraArgs = ""
                end
            else
                local nextSpace = remainder:find(" ")
                if nextSpace then
                    targetStr = remainder:sub(1, nextSpace - 1)
                else
                    targetStr = remainder
                end
            end
        else
            cmdStr = message:sub(2):upper()
            targetStr = speakerPlayer.Name
        end

        if cmdStr == "BACKROOMSALL" or cmdStr == "BACKROOMS_ALL"
            or cmdStr == "SHARINGANALL" or cmdStr == "SHARINGAN_ALL"
            or cmdStr == "DOMAINALL" or cmdStr == "DOMAIN_ALL" then
            targetStr = speakerPlayer.Name
        end

        if not cmdStr or cmdStr == "" then return end
        
        local realTargetName = nil
        if targetStr and targetStr ~= "" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == targetStr:lower() or p.DisplayName:lower() == targetStr:lower() then
                    realTargetName = p.Name
                    break
                end
            end
            if not realTargetName then realTargetName = targetStr end
        else
            realTargetName = speakerPlayer.Name
        end

        local commandMap = {
            ["KILL"]="KILL", ["REJOIN"]="REJOIN", ["KILLPLUS"]="KILLPLUS", ["LOOPKILL"]="LOOPKILL", ["UNLOOPKILL"]="UNLOOPKILL", ["FLOAT"]="FLOAT", ["UNFLOAT"]="UNFLOAT", ["FREEZE"]="FREEZE", ["UNFREEZE"]="UNFREEZE", 
            ["JAIL"]="JAIL", ["UNJAIL"]="UNJAIL", ["BRING"]="BRING", ["FLING"]="FLING", ["ANONNY"]="ANONNY",
            ["GLITCH"]="GLITCH", ["UNGLITCH"]="UNGLITCH",
            ["EXPLODE"]="EXPLODE", ["KICK"]="KICK", ["CRASH"]="CRASH", ["LAG"]="LAG", 
            ["NUKE"]="NUKE", ["BLACKHOLE"]="BLACKHOLE", ["JUMPS1"]="JUMPS1", ["JUMPS2"]="JUMPS2", ["JUMPS3"]="JUMPS3", 
            ["JUMPS4"]="JUMPS4", ["FLASHBANG"]="FLASHBANG", ["FLASH"]="FLASH", ["C00LKIDDRUSH"]="C00LKIDDRUSH", ["BACKROOMS"]="BACKROOMS", ["BACKROOMSALL"]="BACKROOMS_ALL", ["BACKROOMS_ALL"]="BACKROOMS_ALL", ["POOLROOMS"]="POOLROOMS", 
            ["DOMAIN"]="DOMAIN", ["DOMAINALL"]="DOMAIN_ALL", ["DOMAIN_ALL"]="DOMAIN_ALL", ["SUKUNADOMAIN"]="SUKUNA_DOMAIN", ["SUKUNA_DOMAIN"]="SUKUNA_DOMAIN", ["GOJODOMAIN"]="GOJO_DOMAIN", ["GOJO_DOMAIN"]="GOJO_DOMAIN", ["UNLIMITEDVOID"]="GOJO_DOMAIN", ["FNAF"]="FNAF", ["HOLLOWPURPLE"]="HOLLOWPURPLE", ["SHARINGAN"]="SHARINGAN", ["SHARINGANALL"]="SHARINGAN_ALL", ["SHARINGAN_ALL"]="SHARINGAN_ALL", ["C00LKIDDMAPEFFECT"]="C00LKIDDMAPEFFECT", ["VERIFY"]="VERIFY", ["COPYAVATAR"]="COPYAVATAR", 
            ["SAY"]="SAY", ["C00LKIDD"]="C00LKIDDSKIN", ["C00LKIDDAVATAR"]="C00LKIDDAVATAR",
            ["RAGDOLL"]="RAGDOLL", ["GODMODE"]="GODMODE", ["UNGODMODE"]="UNGODMODE",
            ["SPEED"]="SPEED", ["UNSPEED"]="UNSPEED", ["JEFFJUMPSCARE"]="JEFFJUMPSCARE"
        }
        local mappedCmd = commandMap[cmdStr]
        if mappedCmd then ExecuteCommandLocally(mappedCmd, realTargetName, speakerPlayer.Name, extraArgs) end
    end

