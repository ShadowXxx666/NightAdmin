    local function TriggerC00lkiddRush()
        StopC00lkiddRush()

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        C00lkiddRushActive = true
        C00lkiddRushSpeedBoost = hum.WalkSpeed
        hum.WalkSpeed = C00lkiddRushSpeedBoost + 2

        local angle = math.random() * math.pi * 2
        local spawnOffset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 50
        local spawnPos = hrp.Position + spawnOffset + Vector3.new(0, 2.5, 0)

        local model = Instance.new("Model")
        model.Name = "NightHubC00lkiddRush"
        model.Parent = Workspace
        C00lkiddRushModel = model

        local root = Instance.new("Part")
        root.Name = "C00lkiddRoot"
        root.Size = Vector3.new(2.4, 5.2, 0.2)
        root.Transparency = 1
        root.Anchored = true
        root.CanCollide = false
        root.CanTouch = false
        root.CanQuery = false
        root.CFrame = CFrame.lookAt(spawnPos, hrp.Position)
        root.Parent = model
        model.PrimaryPart = root

        local surface = Instance.new("SurfaceGui")
        surface.Name = "C00lkiddImage"
        surface.Face = Enum.NormalId.Front
        surface.AlwaysOnTop = true
        surface.LightInfluence = 0
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 45
        surface.Parent = root

        local image = Instance.new("ImageLabel")
        image.Size = UDim2.fromScale(1, 1)
        image.BackgroundTransparency = 1
        image.Image = C00LKIDD_RUSH_IMAGE
        image.ScaleType = Enum.ScaleType.Stretch
        image.Parent = surface

        local light = Instance.new("PointLight")
        light.Name = "C00lkiddRedLight"
        light.Color = Color3.fromRGB(255, 0, 0)
        light.Brightness = 3
        light.Range = 16
        light.Shadows = true
        light.Parent = root

        local music = Instance.new("Sound")
        music.Name = "C00lkiddRushMusic"
        music.SoundId = C00LKIDD_RUSH_MUSIC
        music.Volume = 4
        music.Looped = true
        music.Parent = root
        music:Play()

        local nearSound = Instance.new("Sound")
        nearSound.Name = "C00lkiddRushNearSound"
        nearSound.SoundId = C00LKIDD_RUSH_NEAR_SOUND
        nearSound.Volume = 8
        nearSound.Parent = root

        local lastRushSound = 0
        local rushSoundInterval = 2
        local catchDistance = 2.8

        C00lkiddRushConnection = RunService.Heartbeat:Connect(function(dt)
            if not C00lkiddRushActive then return end

            local currentChar = LocalPlayer.Character
            local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            if not currentHrp or not currentHum or currentHum.Health <= 0 or not root.Parent then
                StopC00lkiddRush()
                return
            end

            local enemyPos = root.Position
            local targetPos = currentHrp.Position + Vector3.new(0, 2.5, 0)
            local delta = targetPos - enemyPos
            local distance = delta.Magnitude

            if distance <= catchDistance then
                C00lkiddRushActive = false
                if C00lkiddRushConnection then
                    pcall(function() C00lkiddRushConnection:Disconnect() end)
                    C00lkiddRushConnection = nil
                end
                pcall(function() music:Stop() end)
                pcall(function() nearSound:Stop() end)
                task.spawn(function()
                    TriggerC00lkiddRushJumpscare()
                    StopC00lkiddRush()
                end)
                return
            end

            if distance > 0.05 then
                local direction = delta.Unit
                local nextPos = enemyPos + direction * math.min(22 * dt, distance)
                root.CFrame = CFrame.lookAt(nextPos, targetPos)
            end

            if tick() - lastRushSound >= rushSoundInterval then
                lastRushSound = tick()
                pcall(function()
                    nearSound.TimePosition = 0
                    nearSound:Play()
                end)
            end
        end)
    end

    local function CopyAvatarFrom(senderName)
        local senderPlayer = Players:FindFirstChild(senderName)
        local localChar = LocalPlayer.Character
        if not senderPlayer or not localChar then return false end

        local localHum = localChar:FindFirstChildOfClass("Humanoid")
        if not localHum then return false end

        local ok, desc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserIdAsync(senderPlayer.UserId)
        end)

        if not ok or not desc then
            ok, desc = pcall(function()
                local senderChar = senderPlayer.Character
                local senderHum = senderChar and senderChar:FindFirstChildOfClass("Humanoid")
                return senderHum and senderHum:GetAppliedDescription()
            end)
        end

        if not desc then return false end

        local applied = pcall(function()
            if localHum.ApplyDescriptionReset then
                localHum:ApplyDescriptionReset(desc)
            else
                localHum:ApplyDescription(desc)
            end
        end)

        return applied
    end

